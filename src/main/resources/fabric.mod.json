{
	"schemaVersion": 1,
	"id": "resource-synchronization",
	"version": "${version}",
	"name": "Resource-Synchronization",
	"description": "A simple mod that can automatically sync mods and resourcepacks from a server!",
	"authors": [
		"Qingha821",
		"Zbx1425"
	],
	"contact": {
		"sources": "https://github.com/Qingha821/Resource-Synchronization-Release"
	},
	"license": "CC0-1.0",
	"icon": "assets/resource-synchronization/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"github.qingha.ResourceSynchronization"
		],
		"client": [
			"github.qingha.ResourceSynchronizationClient"
		],
		"cpreLaunch": [
			"github.qingha.ResourceSynchronizationPreLaunch"
		]
	},
	"mixins": [
		"resource-synchronization.mixins.json",
		{
			"config": "resource-synchronization.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}